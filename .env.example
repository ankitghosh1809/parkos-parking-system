# Copy this file to .env for local development (backend/.env if your
# tooling loads it from there) and fill in real values. Never commit
# the actual .env file.

# Postgres connection string (Neon, or any Postgres works).
# On Vercel, use Neon's *pooled* connection string - each serverless
# invocation opens its own connection, and the pooler keeps that sane.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Shared password operators log in with to park/checkout vehicles.
# Pick something real - this gates the only two write endpoints in the app.
OPERATOR_PASSWORD=change-me

# Random string used to sign login session tokens. Not the same as
# OPERATOR_PASSWORD. Generate one with: openssl rand -hex 32
SECRET_KEY=change-me-too

# Comma-separated list of origins allowed to call the API. Only
# matters if you're calling the API from a different origin than
# where it's hosted (e.g. a separately-served local frontend, or a
# separate admin dashboard). The deployed frontend calls the API
# same-origin and doesn't need this.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
